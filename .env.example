# Copy this file to .env and fill in your own key. .env is gitignored.

# NVIDIA-hosted OpenAI-compatible API (https://integrate.api.nvidia.com/v1)
# used for the Step 4 (Detection) and Step 5 (Refactoring) LLM agents.
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=

# Optional: override the default model.
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
